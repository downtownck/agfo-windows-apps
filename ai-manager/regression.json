    {
      "id": "modal.browser",
      "title": "AI Kontrol Merkezi opens from the admin bar, lists models, selects with click, saves (live)",
      "type": "browser",
      "required_for_package": false,
      "covers": [
        "ajax:agfo_qs_get_data",
        "ajax:agfo_qs_save",
        "button:#qs-save-btn",
        "button:#agfo-probe-model-btn"
      ],
      "steps": [
        {
          "action": "goto",
          "url": "/wp-login.php"
        },
        {
          "action": "fill",
          "selector": "#user_login",
          "value": "${AGFO_TEST_USER}"
        },
        {
          "action": "fill",
          "selector": "#user_pass",
          "value": "${AGFO_TEST_PASSWORD}"
        },
        {
          "action": "click",
          "selector": "#wp-submit"
        },
        {
          "action": "wait_for",
          "selector": "#wpadminbar"
        },
        {
          "action": "click",
          "selector": "#wp-admin-bar-agfo-quick-switch > a"
        },
        {
          "action": "wait_for",
          "selector": "#qs-model-list .ax-row >> nth=0"
        },
        {
          "action": "click",
          "selector": "#qs-model-list .ax-row:not([hidden]) >> nth=0"
        },
        {
          "action": "click",
          "selector": "#qs-save-btn"
        },
        {
          "action": "wait_for",
          "selector": "#qs-status-indicator:has-text(\"Kaydedildi\")",
          "timeout": 15000
        },
        {
          "action": "command",
          "command": [
            "php",
            "-r",
            "require getenv('AGFO_TEST_WP_PATH') . '/wp-load.php'; echo 'model=' . get_option('agfo_global_preferred_model', '');"
          ],
          "stdout_regex": "model=\\S+"
        }
      ],
      "since": "17.0.0",
      "setup_steps": [
        {
          "action": "command",
          "command": [
            "php",
            "-r",
            "require getenv('AGFO_TEST_WP_PATH') . '/wp-load.php'; if ( ! get_option('agfo_openai_api_key') ) { update_option('agfo_openai_api_key', $GLOBALS['AGFO_ENC'] ? $GLOBALS['AGFO_ENC']->encrypt('sk-AGFO_REGRESSION') : 'sk-AGFO_REGRESSION'); update_option('agfo_regression_seeded_openai', 1); } update_option('agfo_selected_provider', 'openai'); echo 'ready';"
          ],
          "stdout_contains": "ready"
        }
      ],
      "cleanup_steps": [
        {
          "action": "command",
          "command": [
            "php",
            "-r",
            "require getenv('AGFO_TEST_WP_PATH') . '/wp-load.php'; if ( get_option('agfo_regression_seeded_openai') ) { delete_option('agfo_openai_api_key'); delete_option('agfo_regression_seeded_openai'); } echo 'clean';"
          ],
          "stdout_contains": "clean"
        }
      ]
    },
