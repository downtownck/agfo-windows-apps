#!/bin/sh
s=$(echo "$1" | sed 's/^-script://')
logdir=$(grep '^logdir ' "$s" | cut -d' ' -f2)
mkdir -p "$logdir"; f="$logdir/$(date +%s)_log.txt"
for l in "AGFO: aygitlar taraniyor" "Found 3 devices" "Selected 2 drivers"; do echo "$l" >> "$f"; sleep 0.6; done
echo "devices..." > "$logdir/agfo-devices.txt"
sleep 1.2
